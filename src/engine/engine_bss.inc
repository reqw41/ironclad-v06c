; ============================================================================
; engine_bss.inc — данные движка ИИ залпов (IRONCLAD, порт на Вектор-06Ц).
;
; Только метки на DS: игра подключает этот файл в своё BSS (без начальных
; значений).  Движок НЕ полагается на обнуление при загрузке: семя rnd16
; само берётся из ENG_JIFFY, а FA/MO/MC/vST/vKL/vRK сбрасывает eng_fainit
; в начале каждой партии.
;
; ИСКЛЮЧЕНИЕ — сессионные счётчики SMEMG/SMEMR/SMEMB: они живут всю сессию
; (на MSX — от включения питания), поэтому игра должна обнулить их один раз
; при старте программы и больше не трогать между партиями.
;
; Порядок переменных — как в PARM-блоке оригинала (fold.asm, PARM+16..+135),
; но без указателей на массивы BASIC (pBASE..pPM ушли вместе с setptrs) и без
; неиспользуемых слотов.  Соответствие бывшим адресам MSX — в docs/ENGINE.md.
; ============================================================================

                MODULE  engine

; --- выбор варианта правил (пишет игра до любого вызова движка) -------------
@eng_sp         ds      1       ; 0 = SALVO/BARRAGE (5 кораблей), 1 = SALVO PLUS (7)
@eng_bar        ds      1       ; 1 = BARRAGE (ветки IFDEF BARRULES оригинала)

; --- рабочие переменные (бывший PARM-блок 0CF78h) ----------------------------
vH              ds      1       ; PARM+16  попаданий в корабль K (fold) / 0 (kill1)
vLK             ds      1       ; PARM+17  длина корабля
vW              ds      1       ; PARM+18  11-LK: позиций по линии
vK              ds      1       ; PARM+19  номер корабля
vNS1            ds      1       ; (нов.)   NSHIPS+1; обязан идти сразу за vK
vFAP            ds      2       ; PARM+20  -> FA(текущий кандидат)
vIDX            ds      2       ; PARM+22  индекс первой клетки кандидата
vSTEP           ds      2       ; PARM+24  шаг по клеткам: 12 (поперёк) / 1 (вниз)
@vRD            ds      1       ; PARM+32  0CF98h: RD, пишет игра перед eng_explore
@vNF            ds      1       ; PARM+33  0CF99h: NF, число выстрелов залпа
@vRIM           ds      1       ; PARM+34  0CF9Ah: флаг «личность — край»
vST             ds      1       ; PARM+36  метка хода в MO
vJ0F            ds      1       ; PARM+37  первый живой кандидат перерисовки
vBS             ds      2       ; PARM+38  лучший счёт
vBX             ds      1       ; PARM+40
vBY             ds      1       ; PARM+41
vC              ds      1       ; PARM+42  столбец (X)
vR              ds      1       ; PARM+43  строка (Y)
vP9             ds      2       ; PARM+44  индекс клетки с полями: (C+1)*12+(R+1)
vT              ds      1       ; PARM+46  номер выстрела
vRDL            ds      1       ; PARM+47  осталось перерисовок к краю
vBXW            ds      2       ; PARM+48  индекс лучшей клетки
vMODE           ds      1       ; PARM+50  режим cand: 0 отсев, 1 веса MG, 2 счёт в MO
@vKL            ds      1       ; PARM+51  0CFABh: добивание (0 / корабль / 255)
vWT             ds      2       ; PARM+52  вес на клетку кандидата
vSEED           ds      2       ; PARM+54  состояние xorshift
@ENG_SEED       equ     vSEED
vGG             ds      1       ; PARM+56  удавшихся выборок
vSA             ds      1       ; PARM+57  осталось попыток выборки
vSI             ds      1       ; PARM+58
vSJ             ds      1       ; PARM+59
vSCJ            ds      2       ; PARM+60
vRDS            ds      1       ; PARM+62  дрожание 0..7 для MG
vQNC            ds      1       ; PARM+63  клеток в vZX
vO2             ds      1       ; PARM+64
vSOP            ds      2       ; PARM+65  -> vSOA
vOSK            ds      2       ; PARM+68  OS(K)
vT2             ds      1       ; PARM+70  попыток поставить корабль
vJ0             ds      1       ; PARM+72  номер кандидата внутри корабля
vIBB            ds      2       ; PARM+74  индекс первой клетки
vS9             ds      2       ; PARM+76  шаг кандидата
vW2             ds      2       ; PARM+78  13-S9: боковой сосед
vSOA            ds      8       ; PARM+80  корабли по возрастанию CC
vZX             ds      42      ; PARM+88  до 21 клетки выборки (слова)
@vRK            ds      1       ; PARM+130 0CFFAh: вердикт «флот у края» в этой партии
vCCK            ds      2       ; PARM+131 CC(K) в probesel
vNEED           ds      1       ; PARM+135 SZ-PH (только BARRAGE)
vSMC            ds      1       ; (нов.)   mgseed: 0 = только дрожание, 1 = MC*8+дрожание

; --- плоскости (бывшие MOBUF 0D008h, MCBUF 0D098h, FABUF 0D128h) ------------
MOBUF           ds      144     ; метки ходов, байт на клетку 12x12
MCBUF           ds      144     ; покрытие живыми кандидатами, байт на клетку
@ENG_MC         equ     MCBUF
FABUF           ds      1120    ; флаги кандидатов (всегда размер SALVO PLUS)
@ENG_FA         equ     FABUF

; --- сессионные счётчики (бывшие 0DDF0h..0DDF2h) ------------------------------
@SMEMG          ds      1       ; партий выучено (<= 14)
@SMEMR          ds      1       ; клеток края увидено
@SMEMB          ds      1       ; привычка «край» выучена (читает eng_explore)

                ASSERT  vNS1 == vK+1

                ENDMODULE
